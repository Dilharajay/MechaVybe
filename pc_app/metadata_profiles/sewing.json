        {"id": "fabric", "label": "Fabric", "type": "text", "default": "cotton"},
        {"id": "needle", "label": "Needle", "type": "text", "default": "standard"},
        {"id": "thread", "label": "Thread", "type": "text", "default": "polyester"},
        {"id": "load", "label": "Load", "type": "text", "default": "normal"}
